{
  "expo": {
    "name": "AIS — Abdulkadir Intermarket Strategies",
    "slug": "intermarket-strategist",
    "scheme": "intermarketstrategist",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.intermarketstrategist.app"
    },
    "android": {
      "package": "com.intermarketstrategist.app",
      "adaptiveIcon": {
        "backgroundColor": "#061321",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#67DDF3",
          "defaultChannel": "market-updates",
          "enableRemoteNotifications": true
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "bfa1bb8d-b37a-496e-b6b3-4880f56b7656"
      }
    },
    "owner": "giniusox",
    "icon": "./assets/icon.png"
  }
}
